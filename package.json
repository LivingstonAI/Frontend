{
  "name": "snowaivite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "public/electron.js",
  "proxy": "https://backend-production-c0ab.up.railway.app",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron-build": "vite build && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@bokeh/bokehjs": "^3.3.4",
    "@bokeh/numbro": "^1.6.2",
    "@bokeh/slickgrid": "^2.4.4103",
    "@chatscope/chat-ui-kit-react": "^1.10.1",
    "@ckeditor/ckeditor5-build-classic": "^39.0.1",
    "@ckeditor/ckeditor5-react": "^6.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.8.4",
    "blockly": "^10.4.3",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.7",
    "choices.js": "^10.2.0",
    "concurrently": "^8.2.2",
    "d3": "^7.9.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "electron": "^28.0.0",
    "ethers": "^6.15.0",
    "flatbush": "^4.4.0",
    "flatpickr": "^4.6.13",
    "hammerjs": "^2.0.8",
    "howler": "^2.2.4",
    "html-react-parser": "^4.2.10",
    "js-cookie": "^3.0.5",
    "jspdf": "^3.0.2",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.474.0",
    "mathjax-full": "^3.2.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "nouislider": "^15.7.1",
    "openai": "^4.17.4",
    "proj4": "^2.10.0",
    "react": "^18.2.0",
    "react-blockly": "^8.1.1",
    "react-bootstrap": "^2.10.0",
    "react-chartjs-2": "^5.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-feather": "^2.0.10",
    "react-globe.gl": "^2.36.0",
    "react-icons": "^5.3.0",
    "react-modal": "^3.16.1",
    "react-moment": "^1.1.3",
    "react-router-dom": "^6.15.0",
    "react-select": "^5.9.0",
    "react-simple-maps": "^3.0.0",
    "react-spinners": "^0.13.8",
    "react-youtube": "^10.1.0",
    "recharts": "^2.15.4",
    "regl": "^2.1.0",
    "scichart": "^4.0.873",
    "slickgrid": "^5.8.1",
    "sprintf-js": "^1.1.3",
    "three": "^0.177.0",
    "timezone": "^1.0.23",
    "twilio-client": "^1.15.1",
    "underscore.template": "^0.1.7",
    "use-force-update": "^1.0.11",
    "uuid": "^9.0.0",
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.3",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "electron-builder": "^24.9.1",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "vite": "^4.4.5",
    "vite-plugin-pwa": "^1.2.0"
  },
  "build": {
    "appId": "com.snowai.browser",
    "productName": "SnowAI Browser",
    "files": [
      "dist/**/*",
      "public/electron.js",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  }
}
